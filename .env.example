# API base path used by the browser. Keep it relative when using the Vite dev proxy.
VITE_API_BASE_URL=/api/v1

# Docker Compose: http://localhost:8080
# ASP.NET Core launch profile alternative: http://localhost:5191
VITE_API_PROXY_TARGET=http://localhost:8080

# Development-only preview for customer routes protected by RequireActor.
VITE_DEMO_CUSTOMER=false
